{
  "apiVersion": "argoproj.io/v1alpha1",
  "kind": "Workflow",
  "metadata": {
    "generateName": "suspend-template-",
    "labels": {
      "workflows.argoproj.io/no-test": "environment"
    }
  },
  "spec": {
    "entrypoint": "suspend",
    "templates": [
      {
        "name": "suspend",
        "steps": [
          [
            {
              "name": "build",
              "template": "hello-world"
            }
          ],
          [
            {
              "name": "approve",
              "template": "approve"
            }
          ],
          [
            {
              "name": "delay",
              "template": "delay"
            }
          ],
          [
            {
              "name": "release",
              "template": "hello-world"
            }
          ]
        ]
      },
      {
        "name": "approve",
        "suspend": {}
      },
      {
        "name": "delay",
        "suspend": {
          "duration": "20"
        }
      },
      {
        "name": "hello-world",
        "container": {
          "image": "busybox",
          "command": [
            "echo"
          ],
          "args": [
            "hello world"
          ]
        }
      }
    ]
  }
}
