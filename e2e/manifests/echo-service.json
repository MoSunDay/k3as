{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "echo",
    "namespace": "default",
    "labels": {
      "app": "echo"
    }
  },
  "spec": {
    "type": "NodePort",
    "selector": {
      "app": "echo"
    },
    "ports": [
      {
        "name": "web",
        "port": 80,
        "targetPort": 8080,
        "protocol": "TCP"
      }
    ]
  }
}
